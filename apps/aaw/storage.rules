rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /contact-attachments/{fileName} {
      allow create: if request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf|text/plain|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
