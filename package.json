{
  "name": "hearing-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:chc": "npm run dev -w apps/chc",
    "dev:aaw": "npm run dev -w apps/aaw",
    "build:chc": "npm run build -w apps/chc",
    "build:aaw": "npm run build -w apps/aaw",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
