# California Hearing Center — environment contract.
#
# Copy to .env.local for local work. Real values live in .env.local and in the
# Vercel project settings, never in the repo. Structured to mirror the sister
# practice's template (Audiology Associates of Westchester).
#
# EVERYTHING HERE IS OPTIONAL except RESEND_API_KEY. Each analytics tag is off
# unless its variable is set, which is deliberate: scope them to the Production
# environment in Vercel so preview deployments never send staging traffic to a
# live property.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, no trailing slash. Defaults to https://www.calhearing.com.
# Only override for a differently-hosted environment.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Contact form — the only real secret in this file
# ---------------------------------------------------------------------------

# Required for contact form email delivery. Without it the form returns a 503
# and tells the patient to call the practice instead.
RESEND_API_KEY=

# Optional. Comma-separated list; adding a second reader is an environment
# change rather than a deploy. Defaults to infochc@hearing-care.org.
CONTACT_FORM_TO_EMAIL=

# Optional. Must be a Resend-verified sender. Defaults to
# "California Hearing Center <admin@hearing-care.org>" — mail leaves from
# hearing-care.org because that is the domain carrying the DKIM record;
# calhearing.com is not set up in Resend.
CONTACT_FORM_FROM_EMAIL=

# Optional. Comma-separated. Empty by default.
CONTACT_FORM_BCC_EMAIL=

# ---------------------------------------------------------------------------
# Analytics — two DISTINCT GA4 properties, so both variables are wanted
# ---------------------------------------------------------------------------

# GTM container. Carries G-XN799HLKX5 plus the eight conversion tags
# (Click_to_Call, Contact_Form_Submission, Get_Directions,
# Schedule_Appointment, Facebook_Click, ...). Production value: GTM-M9CDTZP
NEXT_PUBLIC_GTM_ID=

# The second GA4 property, injected directly on the legacy pages and NOT
# present in the container — set it or it is lost at cutover.
# Production value: G-3KT4C16M4V
#
# (UA-100763869-1 also ran on the legacy site. It is dead — UA is sunset — and
# must not be carried over.)
NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# Third-party trackers carried over from the legacy WordPress site
# ---------------------------------------------------------------------------

# Call tracking. Note this also swaps the displayed phone number to its
# tracking line, so what a visitor sees stops matching the number in the
# markup. That is the product working as intended, not a NAP bug.
# Production value: 90165
NEXT_PUBLIC_WHATCONVERTS_ID=

# Production value: dfid_jRAMAdrt7rJeDVkOBcUJc
NEXT_PUBLIC_DATAFAST_ID=

# Production value: 38a9f2e12389d095
NEXT_PUBLIC_VISIBILITYKIT_ID=

# ---------------------------------------------------------------------------
# Search-engine verification — optional overrides
# ---------------------------------------------------------------------------

# Both tokens are hardcoded in app/layout.tsx and committed on purpose: a
# verification token is a public string, not a secret, and gating it behind an
# env var only added another way to arrive at cutover unverified. Set these
# ONLY if a token is ever reissued.
#
# Search Console is belt-and-braces — calhearing.com is also verified by two
# DNS TXT records. Bing has no DNS fallback, so its meta tag is the only thing
# proving ownership.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Build-time tooling
# ---------------------------------------------------------------------------

# Used only by the review-refresh script, never at runtime.
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Online hearing screener (/free-online-hearing-test/)
# ---------------------------------------------------------------------------

# Uses RESEND_API_KEY from above. Optional overrides:
# Sender for the patient's results email. Falls back to CONTACT_FORM_FROM_EMAIL.
SCREENER_FROM_EMAIL=
# Who gets the staff alert (comma-separated). Falls back to CONTACT_FORM_TO_EMAIL.
SCREENER_ALERT_TO_EMAIL=
# Neon Postgres connection string. Added by the Vercel Marketplace Neon integration.
# Without it the screener still works; the staff alert email is then the only record.
DATABASE_URL=
# Leave unset until an audiologist approves the result bands. While unset, the page
# is noindex and every result, PDF and email says PREVIEW.
NEXT_PUBLIC_SCREENER_CLINICAL_APPROVED=
